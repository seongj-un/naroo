SPRING_PROFILES_ACTIVE=prod

NAROO_AUTH_REFRESH_COOKIE_SECURE=true
NAROO_AUTH_REFRESH_COOKIE_SAME_SITE=Strict
NAROO_CORS_ALLOWED_ORIGINS=https://naroo.app

# If Railway MySQL is attached, its MYSQLHOST/MYSQLPORT/MYSQLUSER/MYSQLPASSWORD/MYSQLDATABASE
# variables are enough. Use these manual overrides only when you are not wiring Railway reference vars.
MYSQL_URL=jdbc:mysql://<prod-mysql-host>:3306/naroo?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=true
MYSQL_USER=<prod-mysql-user>
MYSQL_PASS=<prod-mysql-password>

# If Railway Redis is attached, its REDISHOST/REDISPORT/REDISUSER/REDISPASSWORD
# variables are enough. Use these manual overrides only when you are not wiring Railway reference vars.
NAROO_REDIS_HOST=<prod-redis-host>
NAROO_REDIS_PORT=6379
NAROO_REDIS_USERNAME=
NAROO_REDIS_PASSWORD=

NAROO_JWT_SECRET=<replace-with-at-least-32-byte-random-secret>
NAROO_JWT_ACCESS_TOKEN_TTL_MINUTES=60
NAROO_JWT_REFRESH_TOKEN_TTL_DAYS=3

NAROO_SEED_STUDENT_ENABLED=false
